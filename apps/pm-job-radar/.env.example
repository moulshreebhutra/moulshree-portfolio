# Set these in Vercel -> Project -> Settings -> Environment Variables. Never commit real values.
AUTH_SECRET=            # random string: openssl rand -base64 32
AUTH_GOOGLE_ID=         # Google Cloud OAuth client id
AUTH_GOOGLE_SECRET=     # Google Cloud OAuth client secret
ALLOWED_EMAILS=         # comma separated Google emails allowed to log in
CRON_SECRET=            # random string; Vercel sends it to the cron route
RAPIDAPI_KEY=           # JSearch on RapidAPI (free plan)
GEMINI_API_KEY=         # Google AI Studio (free)
GEMINI_MODEL=gemini-2.5-flash
UPSTASH_REDIS_REST_URL=   # Upstash Redis (free) via Vercel Marketplace
UPSTASH_REDIS_REST_TOKEN=
HUNTER_API_KEY=         # optional, free 50 credits/month
HUNTER_MAX_PER_RUN=2
